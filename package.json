    "esbuild-svelte": "^0.8.0",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.3.0",
    "obsidian": "^1.14.4",
    "svelte": "^5.57.3",
    "svelte-preprocess": "^6.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1"
  },
